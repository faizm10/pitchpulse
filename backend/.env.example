# Local dev: uvicorn on 8001 (see AGENTS.md and README)
PORT=8001
TRAIN_ON_STARTUP=0
MODEL_PATH=app/models/artifacts/world_cup_rf.joblib
DATA_PATH=app/data/world_cup_matches.csv
ALIASES_PATH=app/data/team_aliases.json

# Comma-separated origins if calling FastAPI from the browser (optional).
# Next.js proxies /api/predict server-side, so CORS is not required for production.
# Add your Vercel URL(s) if you test the API directly from the client:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
