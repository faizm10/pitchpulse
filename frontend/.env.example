# Local FastAPI (see AGENTS.md — port 8001)
PREDICT_API_URL=http://127.0.0.1:8001

# Production / preview on Vercel (set in dashboard, not in this file):
# PREDICT_API_URL=https://pitchpulse-api-dsye.onrender.com

# Set to 0 to disable FotMob proxy routes (standings links, team hubs, match extras)
FOTMOB_ENABLED=1

# PostHog analytics (optional — leave key blank to disable)
NEXT_PUBLIC_POSTHOG_KEY=
# UI host for session replay / toolbar links (US cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Server-side API host (defaults to https://us.i.posthog.com)
POSTHOG_API_HOST=https://us.i.posthog.com
